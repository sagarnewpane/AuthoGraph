# Local development. Set false for deployment; production refuses missing/weak keys.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
FRONTEND_URL=http://localhost:5173
# Generate each secret independently: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
JWT_SIGNING_KEY=replace-with-a-different-long-random-secret
IMAGE_MASTER_KEY=replace-with-a-separate-long-random-image-key
# Same value in frontend/.env. Signs trusted client IPs used for rate limits and activity.
INTERNAL_PROXY_SECRET=replace-with-a-long-random-proxy-secret
# Keep IMAGE_MASTER_KEY securely backed up: changing it without rotating keys makes files unreadable.
# IMAGE_PREVIOUS_MASTER_KEY=old-key-during-an-explicit-rotation
# DATABASE_URL=postgres://user:password@localhost:5432/authograph
# REDIS_URL=redis://localhost:6379/1
# SQLITE_PATH=/absolute/path/to/authograph.sqlite3
# MEDIA_ROOT=/absolute/path/to/private-media
# STORAGE_QUOTA_BYTES=2147483648
# Required for verification and password reset emails.
HOST_MAIL=your-address@gmail.com
MAIL_PASSWORD=your-google-app-password
# Optional local testing only: writes email to files; never use for a public deployment.
# EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
# EMAIL_FILE_PATH=/tmp/authograph-mail
# Explicit opt-in HTTPS processor; leave unset to disable AI image processing.
# AI_PROTECTION_URL=https://your-processor.example/perturb
