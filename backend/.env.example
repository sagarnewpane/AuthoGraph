# Django and JWT secrets
# Generate values with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
JWT_SIGNING_KEY=replace-with-a-different-long-random-secret

# Optional: override the default backend/db.sqlite3 location.
# This must be an absolute path. Leave it commented to use the default.
# SQLITE_PATH=/absolute/path/to/authograph.sqlite3

# Optional: required only for Gmail-based password-reset emails.
HOST_MAIL=your-address@gmail.com
MAIL_PASSWORD=your-google-app-password
