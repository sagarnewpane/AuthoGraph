# Private server-to-server address. Never exposed to the browser.
BACKEND_URL=http://127.0.0.1:8000
# Required behind a production reverse proxy (adapter-node).
# ORIGIN=https://your-domain.example
# BODY_SIZE_LIMIT=22M
# Same secret as backend/.env. Required for per-client rate limits behind this frontend.
INTERNAL_PROXY_SECRET=replace-with-a-long-random-proxy-secret
